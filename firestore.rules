rules_version = '2';

// SDSHC Games Hub — Firestore security rules (Phase 1B).
//
// Threat model (per the fluttering-dove plan): block trivial console tampering,
// not a determined attacker. The moderation queue + admin delete-score controls
// handle the rest. Known accepted soft spots are noted inline.
//
// Deploy: Firebase Console → Firestore → Rules → paste → Publish.
// Admins are identified by a doc at /admins/{uid} (create it in the console for
// your admin user's UID).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Teams ──────────────────────────────────────────────────────────────
    // Public read (the leaderboard reads all teams to map names/colors and
    // filters to approved in JS). Pending names are therefore technically
    // readable from the raw DB — accepted: the profanity filter guards entry
    // and only approved teams are ever displayed.
    match /teams/{teamId} {
      allow read: if true;

      // Anyone can create a team, but only as a pending entry with a sane name.
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.normalized is string;

      // Status changes, renames, merges, deletes are admin-only.
      allow update, delete: if isAdmin();
    }

    // ── Events ─────────────────────────────────────────────────────────────
    // Public read. Admins have full write. Unauthenticated clients may modify
    // ONLY the roster array (players adding a pending team during a game) —
    // never name/status/dates. An attacker could still rewrite the roster, but
    // can't start/end/rename events; an organizer cleans up via admin.
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roster']);
    }

    // ── Scores ─────────────────────────────────────────────────────────────
    // Public read. Anyone can create a score (kiosk play is unauthenticated),
    // with a points value clamped to a sane range. No client edits/deletes —
    // re-tagging (merge) and removal are admin-only.
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.gameId is string
        && request.resource.data.runId is string
        && request.resource.data.points is int
        && request.resource.data.points >= -100000
        && request.resource.data.points <= 100000;
      allow update, delete: if isAdmin();
    }

    // ── Admins ─────────────────────────────────────────────────────────────
    // Readable so isAdmin() checks work for signed-in users; only admins (or
    // the console) can change the set.
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Config (optional future hardening, e.g. per-game point caps) ────────
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
